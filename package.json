{
  "name": "dsh-plugin-structured-prompt",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 结构化输入任务插件：把输入框切换为结构化提示词表单（身份/目标/硬性规则/工具策略/输出格式/兜底/示例），工具策略支持自动或由用户点名工具，构建完可同步回输入框",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "tools",
    "tests",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuChenLiao/dsh-plugin-structured-prompt.git"
  },
  "homepage": "https://github.com/YuChenLiao/dsh-plugin-structured-prompt#readme",
  "bugs": {
    "url": "https://github.com/YuChenLiao/dsh-plugin-structured-prompt/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-engineering",
    "structured-input"
  ],
  "license": "MIT"
}
