{
  "name": "dsh-plugin-structured-prompt",
  "version": "0.4.0",
  "private": true,
  "description": "DSH 结构化提示词插件（两个可独立装载的组件）：结构化提示词表单 + 模型可调用的构建工具（可选用模板起步、可选直投子代理），以及提示词库检索（prompts.chat，宿主代发、检索结果不经过构建器）。模板库数据在 src/components/structured/shared/templates.json",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./structured": {
      "default": "./lib/structured.js"
    },
    "./library": {
      "default": "./lib/library.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "tools",
    "tests",
    "docs",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuChenLiao/dsh-plugin-structured-prompt.git"
  },
  "homepage": "https://github.com/YuChenLiao/dsh-plugin-structured-prompt#readme",
  "bugs": {
    "url": "https://github.com/YuChenLiao/dsh-plugin-structured-prompt/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-engineering",
    "structured-input"
  ],
  "license": "MIT"
}
